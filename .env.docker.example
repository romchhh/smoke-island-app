# Copy to .env.docker and fill secrets.
# Same Atlas cluster as Elf Duck; use a DIFFERENT database name.
# Host port: API 3010 (not 3000–3006 — elf-duck-shop).
# Nginx is separate — deploy/nginx.conf.example.

NODE_ENV=development
PORT=3000

# Atlas (replica set included). Do not commit real credentials.
# Example shape (Elf Duck uses .../test — Smoke Island uses DATABASE_NAME below):
# DATABASE_URL=mongodb+srv://USER:PASS@elf-duck-shop.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=smoke-island
DATABASE_URL=
DATABASE_NAME=SmokeIslandLocal

JWT_SECRET=change-me-docker-jwt-secret-32chars-min
SESSION_SECRET=change-me-docker-session-secret-32chars

FRONTEND_URL=http://localhost:8765
BACKEND_URL=http://localhost:3010
CORS_ORIGIN=http://localhost:8765,http://127.0.0.1:8765

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3010/api/v1/auth/google/callback

TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_CLIENT_BOT_TOKEN=
TELEGRAM_CLIENT_BOT_USERNAME=
TELEGRAM_WEB_APP_URL=http://localhost:8765

TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=http://localhost:3010/api/v1/auth/telegram/callback

TELEGRAM_ORDERS_CHAT_ID=
TELEGRAM_SUPPORT_CHAT_ID=

RESEND_API_KEY=
EMAIL_FROM=
