# Copy to .env.docker and adjust for Docker Compose.
# docker compose --env-file .env.docker up -d --build
# Demo catalog: docker compose --env-file .env.docker --profile seed run --rm seed

# development = local HTTP on localhost:8080
# production  = requires HTTPS FRONTEND_URL / CORS_ORIGIN
# Host ports: web 8080, API 3010, mongo 3017 (not 3000–3006 — elf-duck-shop)
# PORT below is the in-container listen port (compose keeps it at 3000).
NODE_ENV=development
PORT=3000

# Local Mongo from compose (replica set). Or point to Atlas instead.
# Single-node replica set inside compose (required for transactions)
DATABASE_URL=mongodb://mongo:27017/?replicaSet=rs0
DATABASE_NAME=SmokeIslandLocal

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-docker-jwt-secret-32chars-min
SESSION_SECRET=change-me-docker-session-secret-32chars

FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_CLIENT_BOT_TOKEN=
TELEGRAM_CLIENT_BOT_USERNAME=
TELEGRAM_WEB_APP_URL=http://localhost:8080

TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=http://localhost:8080/api/v1/auth/telegram/callback

TELEGRAM_ORDERS_CHAT_ID=
TELEGRAM_SUPPORT_CHAT_ID=

RESEND_API_KEY=
EMAIL_FROM=
