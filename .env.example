# Copy to .env.local for local development. Never put real values in this file.
# Same Atlas cluster as Elf Duck; different DATABASE_NAME (replica set via Atlas).
# DATABASE_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority&appName=smoke-island
DATABASE_URL=
DATABASE_NAME=SmokeIslandLocal

# Generate independent random values locally; do not reuse between environments.
JWT_SECRET=
SESSION_SECRET=

# Local values may be set by the developer; production URLs come from hosting.
FRONTEND_URL=http://localhost:8765
BACKEND_URL=http://localhost:3010
CORS_ORIGIN=http://localhost:8765,http://127.0.0.1:8765,http://localhost:5173
NODE_ENV=development
# 3010 — avoids clash with elf-duck-shop (3000–3006) on the same host
PORT=3010

# Google OAuth web application. Keep secret on the server only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3010/api/v1/auth/google/callback

# Admin bot token stays in the admin-bot service only.
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# Bootstrap allowlist for first setup; roles must also be stored and checked in DB.
TELEGRAM_ADMIN_IDS=

# Client bot for Mini App launch, verified initData and support relay.
TELEGRAM_CLIENT_BOT_TOKEN=
TELEGRAM_CLIENT_BOT_USERNAME=
TELEGRAM_WEB_APP_URL=

# Telegram website sign-in (BotFather -> Login Widget -> OpenID Connect).
# Register FRONTEND_URL/api/v1/auth/telegram/callback as a Redirect URI in BotFather.
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=http://localhost:3010/api/v1/auth/telegram/callback

# Independent routing destinations; chat IDs are configuration, not secrets.
TELEGRAM_ORDERS_CHAT_ID=
TELEGRAM_SUPPORT_CHAT_ID=
# Additional store destinations can be managed in the database.


# Email verification codes (Resend). Use a verified sender domain.
RESEND_API_KEY=
EMAIL_FROM=Smoke Island <no-reply@example.com>
