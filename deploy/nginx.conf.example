# Host nginx (80/443). Docker Compose runs only api (:3010) + mongo (:3017).
# Adjust root if the repo lives elsewhere.

server {
    listen 80;
    server_name smoke-island.telebots.site;
    root /root/smoke-island/frontend;
    index index.html;
    client_max_body_size 16m;

    location ^~ /.well-known/acme-challenge/ {
        default_type text/plain;
        allow all;
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }

    location = /index.html { add_header Cache-Control "no-cache"; }
    location = /config.js { add_header Cache-Control "no-cache"; }
    location / { try_files $uri $uri/ /index.html; }

    location ~ /\. { deny all; }
}
