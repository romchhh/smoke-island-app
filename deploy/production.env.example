# Production template for https://smoke-island.telebots.site
# Copy to /etc/smoke-island.env or .env.docker and fill secrets.
# MongoDB Atlas / replica set required for transactions.
DATABASE_URL=
DATABASE_NAME=SmokeIslandProduction

# Generate with: openssl rand -hex 32 (two different values)
JWT_SECRET=
SESSION_SECRET=

FRONTEND_URL=https://smoke-island.telebots.site
BACKEND_URL=https://smoke-island.telebots.site
CORS_ORIGIN=https://smoke-island.telebots.site
NODE_ENV=production
PORT=3000

# Google OAuth web application. Keep secret on the server only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://smoke-island.telebots.site/api/v1/auth/google/callback

# Admin bot token stays in the admin-bot service only.
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# Bootstrap allowlist for first setup; roles must also be stored and checked in DB.
TELEGRAM_ADMIN_IDS=

# Client bot for Mini App launch, verified initData and support relay.
TELEGRAM_CLIENT_BOT_TOKEN=
TELEGRAM_CLIENT_BOT_USERNAME=
TELEGRAM_WEB_APP_URL=https://smoke-island.telebots.site

# Telegram website sign-in (BotFather -> Login Widget -> OpenID Connect).
# Register FRONTEND_URL/api/v1/auth/telegram/callback as a Redirect URI in BotFather.
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=https://smoke-island.telebots.site/api/v1/auth/telegram/callback

# Independent routing destinations; chat IDs are configuration, not secrets.
TELEGRAM_ORDERS_CHAT_ID=
TELEGRAM_SUPPORT_CHAT_ID=

# Email verification codes (Resend). Use a verified sender domain.
RESEND_API_KEY=
EMAIL_FROM=Smoke Island <no-reply@example.com>
