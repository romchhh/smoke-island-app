{
  "name": "smoke-island",
  "private": true,
  "version": "1.0.0",
  "description": "Smoke Island storefront + API local tooling",
  "scripts": {
    "mongo": "mongod --dbpath .data/mongo --replSet rs0 --bind_ip 127.0.0.1 --port 27017 --logpath .data/mongod.log --fork",
    "seed": "npm --prefix backend run seed:demo",
    "api": "npm --prefix backend start",
    "web": "node scripts/dev-static.mjs",
    "dev": "node scripts/dev.mjs",
    "docker:up": "DOCKER_BUILDKIT=1 docker compose --env-file .env.docker up -d",
    "docker:build": "DOCKER_BUILDKIT=1 docker compose --env-file .env.docker build",
    "docker:rebuild": "DOCKER_BUILDKIT=1 docker compose --env-file .env.docker up -d --build",
    "docker:rebuild:api": "DOCKER_BUILDKIT=1 docker compose --env-file .env.docker up -d --build --no-deps api",
    "docker:seed": "docker compose --env-file .env.docker --profile seed run --rm seed",
    "docker:down": "docker compose --env-file .env.docker down",
    "docker:logs": "docker compose --env-file .env.docker logs -f api",
    "test": "npm --prefix backend test",
    "test:integration": "npm --prefix backend run test:integration"
  },
  "engines": {
    "node": ">=22"
  }
}
